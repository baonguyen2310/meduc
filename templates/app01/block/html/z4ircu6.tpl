{strip}<div class="dc-order-success my-45" dc-order-success>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-9">
                <div class="alert alert-success mb-40">
                    Cảm ơn bạn đã đặt hàng tại MEDUC.VN! Mã đơn hàng của bạn là <strong cart-id></strong>.
                </div>
                
                <div class="title-section-2 mb-15">
                    <span>Thông tin khách hàng</span>
                </div>
                <div class="inner-info mb-40">
                    <div class="inner-info-item">
                        <span>Họ tên: </span>
                        <strong value-name></strong>
                    </div>
                    <div class="inner-info-item">
                        <span>Số điện thoại: </span>
                        <strong value-phone></strong>
                    </div>
                    <div class="inner-info-item">
                        <span>Email: </span>
                        <strong value-email></strong>
                    </div>
                    <div class="inner-info-item">
                        <span>Địa chỉ: </span>
                        <strong value-address></strong>
                    </div>
                    <div class="inner-info-item">
                        <span>Ghi chú: </span>
                        <strong value-note></strong>
                    </div>
                </div>
                <div class="title-section-2 mb-15">
                    <span>Danh sách sản phẩm</span>
                </div>
                <div class="inner-products" product-list></div>
                <div class="inner-price-total">
                    <span>Tổng tiền:</span>
                    <strong price-total></strong>
                    <small>VND</small>
                </div>
            </div>
        </div>
    </div>
</div>{/strip}