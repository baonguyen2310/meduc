{strip}
{$categories = $this->Category->getCategories({ARTICLE}, {LANGUAGE}, [{FILTER} => ['parent_id' => 48]])}
{$document_view = $this->loadHelper('Document')}
{$catalog = $document_view->getCatalog($categories, PAGE_CATEGORY_ID, {LANGUAGE})}
{$text = $data_extend.locale[{LANGUAGE}]|default:[]}
{$keyword = $this->getRequest()->getQuery('keyword')}{if !is_string($keyword)}{$keyword = ''}{/if}
<link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">
<link href="/templates/{CODE_TEMPLATE}/assets/meduc-v2/document-catalog.css?v=20261015" rel="stylesheet">
<script src="/templates/{CODE_TEMPLATE}/assets/meduc-v2/document-catalog.js?v=20261015" defer></script>
<main class="mdc" id="document-catalog-page" data-active-category="{PAGE_CATEGORY_ID}">
    <svg class="mdc-symbols" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><symbol id="mdc-arrow" viewBox="0 0 24 24"><path d="M4 12h16m-6-6 6 6-6 6"/></symbol><symbol id="mdc-file" viewBox="0 0 24 24"><path d="M14 3H5v18h14V8Zm0 0v5h5M8 13h8m-8 4h6"/></symbol><symbol id="mdc-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></symbol></svg>
    <section class="mdc-hero {if !empty($catalog.category)}mdc-hero--category{/if}" aria-labelledby="documents-title"><div class="mdc-shell mdc-hero-inner">
        <div class="mdc-hero-copy"><p class="mdc-eyebrow">MEDUC / THƯ VIỆN TÀI LIỆU</p>{if !empty($catalog.category)}<a class="mdc-back" href="/tai-lieu-hoc-tap">← Thư viện tài liệu</a><h1 id="documents-title">{$catalog.category.name|escape}</h1>{else}<h1 id="documents-title">{$text.tieu_de_1|default:'ĐÚNG TÀI LIỆU.'|escape}<span>{$text.tieu_de_2|default:'VỮNG KIẾN THỨC.'|escape}</span></h1>{/if}<p class="mdc-intro">{$text.mo_ta|default:'Giáo trình, bài giảng và tài liệu ôn tập cho hành trình học Y. Bắt đầu từ môn bạn đang học, tìm thêm một góc nhìn để hiểu sâu hơn.'|escape}</p><a class="mdc-button" href="#document-library">Khám phá tài liệu <span aria-hidden="true">↓</span></a><p class="mdc-total"><strong>{count($catalog.documents)}</strong> tài liệu đang mở <span aria-hidden="true">/</span> Theo môn và năm học</p></div>
        {if empty($catalog.category)}<div class="mdc-hero-art" aria-label="Tài liệu từ thư viện MedUC"><span class="mdc-art-label">ĐỌC. HIỂU. KẾT NỐI.</span><div class="mdc-paper-grid">{foreach from=$catalog.hero item=document}<a href="{$this->Utilities->checkInternalUrl($document.url)|escape}" aria-label="{$document.name|escape}"><img src="{CDN_URL}{$this->Utilities->getThumbs($document.image, 350)}" alt="{$document.name|escape}" decoding="async"><span>{$document.year_label|escape}</span></a>{/foreach}</div><span class="mdc-art-note"><svg aria-hidden="true"><use href="#mdc-file"/></svg><span>KIẾN THỨC LỚN.<br>TỪ TỪNG TRANG NHỎ.</span></span></div>{/if}
    </div></section>
    <section class="mdc-shell mdc-paths" aria-label="Tài liệu theo năm học"><div class="mdc-path-heading"><p class="mdc-eyebrow">CHỌN CHẶNG ĐƯỜNG CỦA BẠN</p><a href="/tai-lieu-hoc-tap#document-library" data-document-all>Tất cả tài liệu <svg aria-hidden="true"><use href="#mdc-arrow"/></svg></a></div><div class="mdc-year-grid">
        {foreach from=[75, 122, 123, 124] item=year_category_id}{foreach from=$categories item=category}{if $category.id == $year_category_id}
            {$year = 1}{if $category.id == 122}{$year = 2}{elseif $category.id == 123}{$year = 3}{elseif $category.id == 124}{$year = 4}{/if}
            <a class="mdc-year" href="{$this->Utilities->checkInternalUrl($category.url)|escape}#document-library" data-document-year="{$year}" {if PAGE_CATEGORY_ID == $category.id}aria-current="true"{/if}><span class="mdc-year-number" aria-hidden="true">0{$year}</span><span><strong>{$category.name|escape}</strong><small>{$catalog.year_counts[$year]} tài liệu</small></span><svg aria-hidden="true"><use href="#mdc-arrow"/></svg></a>
        {/if}{/foreach}{/foreach}
    </div></section>
    <section class="mdc-library" id="document-library" aria-labelledby="document-library-title"><div class="mdc-shell">
        <div class="mdc-heading"><div><p class="mdc-eyebrow">THƯ VIỆN HỌC TẬP</p><h2 id="document-library-title">TÌM TÀI LIỆU.<br><span>HỌC ĐIỀU BẠN CẦN.</span></h2></div><p>Từ kiến thức cơ sở đến thực hành lâm sàng. Chọn một tài liệu để xem giới thiệu và các tệp đính kèm.</p></div>
        <form class="mdc-tools" role="search" data-document-tools hidden><label class="mdc-search"><svg aria-hidden="true"><use href="#mdc-search"/></svg><span class="mdc-sr-only">Tìm tài liệu</span><input id="document-search" type="search" placeholder="Tên tài liệu, môn học, từ khóa..." value="{$keyword|escape}" autocomplete="off"><button type="button" data-document-clear aria-label="Xóa từ khóa" hidden>×</button></label><label class="mdc-select">Môn học<select id="document-subject"><option value="all">Tất cả môn học</option>{foreach from=$catalog.subjects item=subject}<option value="{$subject.key|escape}">{$subject.name|escape} ({$subject.count})</option>{/foreach}</select></label><label class="mdc-select">Sắp xếp<select id="document-sort"><option value="default">Theo MedUC</option><option value="newest">Mới đăng</option><option value="oldest">Cũ nhất</option><option value="name">Tên A–Z</option></select></label></form>
        <div class="mdc-catalog-bar"><p role="status" aria-live="polite" aria-atomic="true" data-document-status>{count($catalog.documents)} tài liệu trong thư viện</p><button type="button" class="mdc-reset" data-document-reset hidden>Bỏ bộ lọc <span aria-hidden="true">×</span></button></div>
        <div class="mdc-grid" data-document-grid>
            {foreach from=$catalog.documents item=document}
                <article class="mdc-card" data-document-card data-years="{$document.years|escape}" data-subject="{$document.subject_key|escape}" data-categories="{$document.category_ids|escape}" data-created="{$document.created}">
                    <a class="mdc-cover" href="{$this->Utilities->checkInternalUrl($document.url)|escape}" aria-label="Xem {$document.name|escape}"><span class="mdc-cover-fallback" aria-hidden="true"><svg><use href="#mdc-file"/></svg><span>{$document.subject|escape}</span></span>{if !empty($document.image)}<img src="{CDN_URL}{$this->Utilities->getThumbs($document.image, 500)}" alt="{$document.name|escape}" loading="lazy" decoding="async">{/if}<span class="mdc-year-badge">{$document.year_label|escape}</span>{if !empty($document.formats)}<span class="mdc-format">{$document.formats|escape}</span>{/if}</a>
                    <div class="mdc-card-body"><p class="mdc-card-subject">{$document.subject|escape}</p><h3><a href="{$this->Utilities->checkInternalUrl($document.url)|escape}" data-document-title>{$document.title|escape}</a></h3>{if !empty($document.summary)}<p class="mdc-summary">{$document.summary|escape}</p>{/if}<div class="mdc-meta"><span><svg aria-hidden="true"><use href="#mdc-file"/></svg>{$document.file_count} tệp đính kèm</span>{if !empty($document.date)}<time datetime="{$document.date_iso}" title="Ngày đăng">{$document.date}</time>{/if}</div><a class="mdc-card-link" href="{$this->Utilities->checkInternalUrl($document.url)|escape}">Xem tài liệu <svg aria-hidden="true"><use href="#mdc-arrow"/></svg></a></div>
                </article>
            {/foreach}
        </div>
        <div class="mdc-empty" data-document-empty {if !empty($catalog.documents)}hidden{/if}><svg aria-hidden="true"><use href="#mdc-search"/></svg><h3>Chưa tìm thấy tài liệu phù hợp.</h3><p>Thử từ khóa khác hoặc xem lại toàn bộ thư viện.</p><button class="mdc-button" type="button" data-document-empty-reset>Xem tất cả tài liệu <span aria-hidden="true">→</span></button></div><button type="button" class="mdc-more" data-document-more hidden>Xem thêm tài liệu <span aria-hidden="true">↓</span></button>
        <noscript><nav class="mdc-noscript" aria-label="Danh mục tài liệu">{foreach from=$categories item=category}<a href="{$this->Utilities->checkInternalUrl($category.url)|escape}">{$category.name|escape}</a>{/foreach}</nav></noscript>
    </div></section>
    <aside class="mdc-next"><div class="mdc-shell mdc-next-inner"><div><p class="mdc-eyebrow">TIẾP TỤC HÀNH TRÌNH HỌC Y</p><h2>ĐỌC ĐỂ HIỂU.<br><span>HỌC ĐỂ VẬN DỤNG.</span></h2><p>Kết nối điều vừa đọc với bài giảng, lộ trình học và các bài tập theo môn tại MedUC.</p></div><a class="mdc-button" href="/khoa-hoc">Khám phá khóa học <svg aria-hidden="true"><use href="#mdc-arrow"/></svg></a></div></aside>
</main>
{/strip}
