<div class="kt-subheader kt-grid__item"><div class="kt-container kt-container--fluid"><h3 class="kt-subheader__title">{$title_for_layout|escape}</h3><a href="{ADMIN_PATH}/course-prices" class="btn btn-light">← Danh sách bảng giá</a></div></div>
<div class="kt-container kt-container--fluid">
{if $error}<div class="alert alert-danger" role="alert">{$error|escape}</div>{/if}{if $saved}<div class="alert alert-success" role="status">Đã lưu bảng giá, các gói và danh sách môn.</div>{/if}
{$this->Form->create(null,['url'=>"{ADMIN_PATH}/course-prices/edit/{$id}",'type'=>'post','id'=>'course-price-form'])}
<div class="kt-portlet"><div class="kt-portlet__head"><h3 class="kt-portlet__head-title">Thông tin bảng giá</h3></div><div class="kt-portlet__body">
<div class="row"><div class="col-md-6 form-group"><label for="cp-name">Tên bảng báo giá</label><input class="form-control" id="cp-name" name="name" value="{$list.name|escape}" maxlength="180" required></div><div class="col-md-6 form-group"><label for="cp-slug">Đường dẫn</label><input class="form-control" id="cp-slug" name="slug" value="{$list.slug|escape}" maxlength="180" placeholder="Tự tạo từ tên nếu để trống"></div></div>
<div class="form-group"><label for="cp-kind">Loại bảng giá</label><select class="form-control" id="cp-kind" name="course_type">{foreach $price_list_kinds as $kind=>$kind_label}<option value="{$kind|escape}" {if $list.course_type==$kind}selected{/if}>{$kind_label|escape}</option>{/foreach}</select><small class="text-muted">Mỗi bảng giá chỉ chứa một loại: Ôn kiến thức, Chữa đề hoặc Trắc nghiệm.</small></div><div class="form-group"><label for="cp-description">Mô tả ngắn</label><textarea class="form-control" id="cp-description" name="description" rows="3" maxlength="3000">{$list.description|escape}</textarea></div>
<div class="row"><div class="col-md-3 form-group"><label for="cp-position">Thứ tự</label><input id="cp-position" class="form-control" type="number" name="position" value="{$list.position|default:0}"></div><div class="col-md-3 form-group"><label for="cp-status">Trạng thái</label><select class="form-control" id="cp-status" name="status"><option value="1" {if $list.status}selected{/if}>Đang mở</option><option value="0" {if !$list.status}selected{/if}>Đang ẩn</option></select></div></div>
</div></div>
<div class="kt-portlet"><div class="kt-portlet__head"><h3 class="kt-portlet__head-title">Các gói học</h3></div><div class="kt-portlet__body"><p class="text-muted">Giá tính bằng VNĐ, nhập số nguyên không có dấu phân cách. Mỗi quyền lợi trên một dòng. Có thể ẩn gói mà vẫn giữ dữ liệu đơn cũ.</p>
<div id="cp-packages">{foreach $packages as $k=>$p}
<section class="cp-package border rounded p-3 mb-3"><input type="hidden" name="packages[{$k}][id]" value="{$p.id|default:0}">
<div class="row"><div class="col-md-3 form-group"><label>Tên gói</label><input class="form-control" name="packages[{$k}][name]" value="{$p.name|escape}" maxlength="120" required></div><div class="col-md-2 form-group"><label>Số môn</label><input class="form-control" name="packages[{$k}][course_count]" type="number" min="1" max="1000" value="{$p.course_count}" required></div><div class="col-md-3 form-group"><label>Giá gốc (đ)</label><input class="form-control" name="packages[{$k}][price]" type="number" min="1" step="1" value="{$p.price}" required></div><div class="col-md-3 form-group"><label>Giá ưu đãi (đ)</label><input class="form-control" name="packages[{$k}][sale_price]" type="number" min="1" step="1" value="{$p.sale_price|default:''}"></div><div class="col-md-1 form-group"><label>Thứ tự</label><input class="form-control" name="packages[{$k}][position]" type="number" value="{$p.position}"></div></div>
<div class="row"><div class="col-md-8 form-group"><label>Quyền lợi</label><textarea class="form-control" name="packages[{$k}][benefits]" rows="4" maxlength="5000">{$p.benefits|escape}</textarea></div><div class="col-md-4"><label class="d-block mt-3"><input type="checkbox" name="packages[{$k}][recommended]" value="1" {if !empty($p.recommended)}checked{/if}> Gói được đề xuất</label><label class="d-block mt-3"><input type="checkbox" name="packages[{$k}][status]" value="1" {if !empty($p.status)}checked{/if}> Mở đăng ký gói</label><button type="button" class="btn btn-sm btn-light mt-3" data-cp-remove>Ẩn gói này</button></div></div>
</section>{/foreach}</div><button type="button" class="btn btn-outline-primary" id="cp-add">+ Thêm gói học</button>
</div></div>
<div class="kt-portlet"><div class="kt-portlet__head"><h3 class="kt-portlet__head-title">Các môn trong bảng giá</h3></div><div class="kt-portlet__body"><p class="text-muted">Chọn hoặc bỏ chọn từng môn. Chọn môn đang ở bảng khác sẽ chuyển môn đó sang bảng này.</p><input class="form-control mb-3" id="cp-search" type="search" placeholder="Tìm tên môn…" aria-label="Tìm môn học">
<div class="row" id="cp-courses">{foreach $all as $cid=>$name}<label class="col-md-4 p-2 cp-course" data-course-kind="{$course_kinds[$cid]|escape}"><input type="checkbox" name="course_ids[]" value="{$cid}" {if in_array($cid,$selected)}checked{/if}> {$name|escape}{if !empty($map[$cid]) && $map[$cid]!=$id}<small class="text-muted d-block ml-3">Đang ở: {$price_list_names[$map[$cid]]|escape}</small>{/if}</label>{/foreach}</div></div></div>
<div class="pb-5"><button class="btn btn-brand btn-lg" type="submit">Lưu bảng báo giá</button>{if $id} <a class="btn btn-light" href="/bang-bao-gia/{$list.slug|escape}" target="_blank" rel="noopener">Xem giao diện</a>{/if}</div>
{$this->Form->end()}
</div>
<template id="cp-template"><section class="cp-package border rounded p-3 mb-3"><input type="hidden" name="packages[__N__][id]" value="0"><div class="row"><div class="col-md-3 form-group"><label>Tên gói</label><input class="form-control" name="packages[__N__][name]" maxlength="120" required></div><div class="col-md-2 form-group"><label>Số môn</label><input class="form-control" type="number" name="packages[__N__][course_count]" min="1" max="1000" value="1" required></div><div class="col-md-3 form-group"><label>Giá gốc (đ)</label><input class="form-control" type="number" name="packages[__N__][price]" min="1" step="1" required></div><div class="col-md-3 form-group"><label>Giá ưu đãi (đ)</label><input class="form-control" type="number" name="packages[__N__][sale_price]" min="1" step="1"></div><div class="col-md-1 form-group"><label>Thứ tự</label><input class="form-control" type="number" name="packages[__N__][position]" value="__N__"></div></div><div class="row"><div class="col-md-8 form-group"><label>Quyền lợi</label><textarea class="form-control" name="packages[__N__][benefits]" rows="4" maxlength="5000"></textarea></div><div class="col-md-4"><label class="d-block mt-3"><input type="checkbox" name="packages[__N__][recommended]" value="1"> Gói được đề xuất</label><label class="d-block mt-3"><input type="checkbox" name="packages[__N__][status]" value="1" checked> Mở đăng ký gói</label><button type="button" class="btn btn-sm btn-light mt-3" data-cp-remove>Ẩn gói này</button></div></div></section></template>
{literal}<script>document.addEventListener('DOMContentLoaded',()=>{const box=document.getElementById('cp-packages');let n=box.children.length;document.getElementById('cp-add').addEventListener('click',()=>{if(n>=30)return;const t=document.getElementById('cp-template').innerHTML.replace(/__N__/g,String(n++));box.insertAdjacentHTML('beforeend',t);});box.addEventListener('click',e=>{const b=e.target.closest('[data-cp-remove]');if(!b)return;const s=b.closest('.cp-package');s.querySelector('[name$="[status]"]').checked=false;s.style.opacity='.55';b.textContent='Đã ẩn · chọn Mở đăng ký để bật lại';});const kind=document.getElementById('cp-kind'),search=document.getElementById('cp-search');function filterCourses(changed){const q=search.value.toLocaleLowerCase('vi');document.querySelectorAll('.cp-course').forEach(c=>{const allowed=c.dataset.courseKind===kind.value;const box=c.querySelector('input');box.disabled=!allowed;if(changed&&!allowed)box.checked=false;c.hidden=!allowed||!c.textContent.toLocaleLowerCase('vi').includes(q);});}kind.addEventListener('change',()=>filterCourses(true));search.addEventListener('input',()=>filterCourses(false));filterCourses(false);});</script>{/literal}
